#!/usr/bin/env bash
# Dental_VLA — Quest 3 (무선, CloudXR/IsaacTeleop) VR 텔레옵 한 방 실행
#
#   dental-vr [--print] [--lift 0.10] [--sx -1] [--sy 1] [--sz 1] [--pose grip|aim]
#
# 하는 일
#   1) 남아있던 dora / 브리지 프로세스를 정리한다 (항상 home 자세에서 새로 시작)
#   2) dora 파이프라인을 띄운다  -> MuJoCo 뷰어 GUI 가 함께 뜬다
#   3) 준비되면 Quest 브리지를 앞단에서 실행한다
#   4) Ctrl+C 를 누르면 브리지와 dora 를 모두 정리하고 끝난다
set -u

export DENTAL_VLA="${DENTAL_VLA:-$HOME/projects/Dental_VLA}"
CXR_PY=/home/user/vr_teleop/cloudxr_service_venv/bin/python3
ENVF="$HOME/.cloudxr/run/cloudxr.env"
LOGDIR="${XDG_RUNTIME_DIR:-/tmp}/dental-vr"
mkdir -p "$LOGDIR"
DORA_LOG="$LOGDIR/dora.log"

# --help / -h 는 파이프라인을 띄우지 않고 브리지 도움말만 보여준다
for a in "$@"; do
  case "$a" in
    -h|--help)
      exec /home/user/vr_teleop/cloudxr_service_venv/bin/python3 \
           "$DENTAL_VLA/teleop/dental_vla_teleop/isaacteleop_bridge.py" --help ;;
  esac
done

[ -d "$DENTAL_VLA" ]  || { echo "오류: DENTAL_VLA 경로 없음 -> $DENTAL_VLA" >&2; exit 1; }
[ -x "$CXR_PY" ]      || { echo "오류: IsaacTeleop venv 없음 -> $CXR_PY" >&2; exit 1; }

# CloudXR 런타임 환경변수 (NV_CXR_RUNTIME_DIR, XR_RUNTIME_JSON ...)
if [ -r "$ENVF" ]; then
  set -a; . "$ENVF"; set +a
else
  echo "경고: $ENVF 없음. CloudXR 서비스가 떠 있는지 확인하세요." >&2
  export NV_CXR_RUNTIME_DIR="${NV_CXR_RUNTIME_DIR:-$HOME/.cloudxr/run}"
  export XR_RUNTIME_JSON="${XR_RUNTIME_JSON:-$HOME/.cloudxr/openxr_cloudxr.json}"
fi
export DISPLAY="${DISPLAY:-:1}"
export MUJOCO_GL=glfw
export PYTHONUNBUFFERED=1

cleanup() {
  trap - INT TERM EXIT
  echo
  echo "[dental-vr] 정리 중..."
  [ -n "${BRIDGE_PID:-}" ] && kill "$BRIDGE_PID" 2>/dev/null
  [ -n "${DORA_PID:-}"   ] && kill "$DORA_PID"   2>/dev/null
  sleep 1
  pkill -f 'dora-openarm'        2>/dev/null
  pkill -f 'isaacteleop_bridge'  2>/dev/null
  sleep 1
  pkill -9 -f 'dora-openarm'     2>/dev/null
  echo "[dental-vr] 종료됨."
}
trap cleanup INT TERM EXIT

echo "[dental-vr] 1/3  이전 세션 정리"
pkill -f 'dora-openarm'       2>/dev/null
pkill -f 'isaacteleop_bridge' 2>/dev/null
pkill -f 'mock_quest_sender'  2>/dev/null
sleep 2

echo "[dental-vr] 2/3  dora 파이프라인 + MuJoCo 뷰어 시작"
cd "$DENTAL_VLA/teleop" || exit 1
uv run dora run config/dataflow-mujoco.yaml --uv > "$DORA_LOG" 2>&1 &
DORA_PID=$!

# UDP 5006 이 열릴 때까지 대기 (= 파이프라인 준비 완료)
for i in $(seq 1 60); do
  if ss -lun 2>/dev/null | grep -q ':5006'; then break; fi
  if ! kill -0 "$DORA_PID" 2>/dev/null; then
    echo "[dental-vr] dora 기동 실패. 로그:" >&2; tail -20 "$DORA_LOG" >&2; exit 1
  fi
  sleep 1
done
if grep -q "Collision (Contact) detection is ENABLED" "$DORA_LOG" 2>/dev/null; then
  echo "[dental-vr]      물리/충돌 ON, 뷰어 준비됨"
else
  echo "[dental-vr]      준비 대기 중... (로그: $DORA_LOG)"
  sleep 3
fi

echo "[dental-vr] 3/3  Quest 브리지 시작 (Ctrl+C 로 전체 종료)"
"$CXR_PY" "$DENTAL_VLA/teleop/dental_vla_teleop/isaacteleop_bridge.py" "$@" &
BRIDGE_PID=$!
wait "$BRIDGE_PID"
