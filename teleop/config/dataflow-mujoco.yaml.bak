# VR teleop of the OpenArm in the Dental_VLA v3 scene (with official torso + home keyframe).
# Reuses enactic/dora-openarm-vr nodes; only the mujoco node's --xml points at our scene.
#   uv pip install "dora-rs-cli==0.5.0" "dora-rs==0.5.0"
#   uv run dora build config/dataflow-mujoco.yaml --uv
#   uv run dora run   config/dataflow-mujoco.yaml --uv
nodes:
  - id: quittable-tick-leader
    build: pip install git+https://github.com/enactic/dora-openarm-quitter.git
    path: dora-openarm-quitter
    inputs: { tick: dora/timer/millis/2 }
    outputs: [tick]
  - id: udp-receiver
    build: pip install git+https://github.com/enactic/dora-openarm-vr.git
    path: dora-openarm-quest-receiver
    args: "--host 0.0.0.0 --port 5006"
    inputs: { tick: quittable-tick-leader/tick }
    outputs: [pose_right, trigger_right, grip_right, pose_left, pose_reference, trigger_left, grip_left, joystick_x_left, joystick_y_left, joystick_x_right, joystick_y_right, button_a, button_b, button_x, button_y, status]
  - id: ik
    build: pip install git+https://github.com/enactic/dora-openarm-kinematics
    path: dora-openarm-ik
    args: "--mode bimanual --max-iters 10 --dt 0.1 --damping 0.1 --posture-cost 0.01 --lm-damping 0.01"
    inputs:
      tick: quittable-tick-leader/tick
      target_right: udp-receiver/pose_right
      target_left:  udp-receiver/pose_left
      trigger_right: udp-receiver/trigger_right
      trigger_left:  udp-receiver/trigger_left
    outputs: [position_left, position_right, status]
  - id: mujoco-viewer
    build: pip install git+https://github.com/enactic/dora-openarm-mujoco
    path: dora-openarm-mujoco
    args: "--xml ../../sim/main_v3_teleop.xml --keyframe home --viewer --debug-frames"
    inputs:
      position_left:  ik/position_left
      position_right: ik/position_right
      pose_right:     udp-receiver/pose_right
      pose_left:      udp-receiver/pose_left
      joystick_y:     udp-receiver/joystick_y_left
    outputs: [status]
