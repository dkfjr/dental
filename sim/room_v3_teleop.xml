  <worldbody>
    <!-- ============ 치과의자 세트 (Blender 원본 그대로: 형태·색·재질) ============ -->
    <body name="bl_chair" pos="0 0 0">
      <geom name="bl_Chair_Base_g" type="mesh" mesh="bl_Chair_Base" material="bl_Chrome"/>
      <geom name="bl_Chair_Column_g" type="mesh" mesh="bl_Chair_Column" material="bl_Chrome" pos="0 0 0.0174"/>
      <!-- 기둥 위 전체를 0.12 m 내려 시트 상단 0.90 -> 0.78 (승강식 실물 범위 0.35~0.80) -->
      <body name="bl_chair_upper" pos="0 0 -0.12">
      <geom name="bl_Chair_Column_Upper_g" type="mesh" mesh="bl_Chair_Column_Upper" material="bl_Chrome"/>
      <geom name="bl_Seat_Pan_g" type="mesh" mesh="bl_Seat_Pan" material="bl_CushionBlue"/>
      <!-- 리클라인: 등받이+헤드레스트를 등받이 하단 힌지 (0, 0.230, 0.878) 둘레로 -44° 회전.
           수직대비 28°(업라이트) -> 72°(앙와위). 메시는 월드좌표로 baked 되어 있으므로
           자식 body를 힌지 위치에 두고 geom을 -힌지만큼 되밀어 "힌지 둘레 회전"을 만든다. -->
      <body name="bl_chair_backrest" pos="0 0.230 0.8778" euler="-0.76794 0 0">
        <geom name="bl_Backrest_g" type="mesh" mesh="bl_Backrest" material="bl_CushionBlue" pos="0 -0.230 -0.8778"/>
        <!-- 헤드레스트는 등받이 레일을 따라 슬라이드하는 부품. 의자 전장(2.11 m)이 환자(1.75 m)보다
             길어 기본 위치에서는 머리가 안 닿으므로, 등받이 면을 따라 -0.367 m 내려 뒤통수를 받친다. -->
        <geom name="bl_Headrest_g" type="mesh" mesh="bl_Headrest" material="bl_CushionBlue" pos="0 -0.4024 -1.2021"/>
      </body>
      <!-- 레그레스트: 발쪽으로 7.9° 들려 있고 시트면보다 78mm 낮던 것을 수평 + 시트면(z=0.90) 정렬 -->
      <body name="bl_chair_legrest" pos="0 -0.454 0.900" euler="0.13746 0 0">
        <geom name="bl_Leg_Rest_g" type="mesh" mesh="bl_Leg_Rest" material="bl_CushionBlue" pos="0 0.454 -0.822"/>
      </body>
      <geom name="bl_Armrest_L_g" type="mesh" mesh="bl_Armrest_L" material="bl_WhitePlastic"/>
      <geom name="bl_Armrest_R_g" type="mesh" mesh="bl_Armrest_R" material="bl_WhitePlastic"/>
      </body>
      <!-- 전달지점. 회의록 §6.2 두 가지 안전원칙을 모두 만족하도록 잡았다:
             · "환자 얼굴 위로 기구 이동 금지"  -> 환자 머리(y>=0.498)보다 50 mm 발쪽
             · "가슴 위 거치는 지양"            -> 가슴 중앙이 아니라 **턱 아래 30~100 mm(쇄골 상방)**
           사양서 §9-2 V 의 두부측 끝단에 해당. 체표면에서 50 mm 이상 떠 있고,
           의사·로봇 모두 신전율 0.73 으로 여유 있게 도달한다. -->
      <site name="handoff" pos="0.050 0.470 1.200" size="0.018" rgba="0.2 0.9 0.4 0.55" group="3"/>
    </body>
    <body name="bl_cart" pos="0.0000 -0.2000 0.0000">
      <geom name="bl_Cart_Caster_-1_-1_g" type="mesh" mesh="bl_Cart_Caster_-1_-1" material="bl_DarkPlastic"/>
