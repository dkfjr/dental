    <body name="bl_tray" pos="0.0000 -0.2000 0.0000">
      <geom name="bl_Tray_Base_g" type="mesh" mesh="bl_Tray_Base" material="bl_TraySteel"/>
      <geom name="bl_Tray_SideWall_-0.32_g" type="mesh" mesh="bl_Tray_SideWall_-0.32" material="bl_TraySteel"/>
