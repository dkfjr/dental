         teleop/tools/cap_doctor_holes.py 로 생성. 원본 DocPart_* 는 그대로 둔다. -->
    <mesh name="doc_torso" file="doctor_rig/DocPart_torso.obj"/>
    <mesh name="doc_upper_arm" file="doctor_rig/DocPart_upper_arm.obj"/>
    <mesh name="doc_forearm" file="doctor_rig/DocCap_forearm.obj"/>
    <mesh name="doc_hand" file="doctor_rig/DocCap_hand.obj"/>
