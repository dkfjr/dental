      <geom name="bl_Cart_Post_1_-1_g" type="mesh" mesh="bl_Cart_Post_1_-1" material="bl_CartFrame"/>
      <geom name="bl_Cart_Post_1_1_g" type="mesh" mesh="bl_Cart_Post_1_1" material="bl_CartFrame"/>
      <geom name="bl_Cart_Shelf_Bottom_g" type="mesh" mesh="bl_Cart_Shelf_Bottom" material="bl_CartFrame"/>
      <geom name="bl_Cart_Shelf_Top_g" type="mesh" mesh="bl_Cart_Shelf_Top" material="bl_CartFrame"/>
