      <geom name="bl_SuctionTip_Ti_a_g" type="mesh" mesh="bl_SuctionTip_Ti_a" material="bl_SurgSteel" density="7800" condim="4" priority="2" friction="1.2 0.05 0.01" solref="0.005 1" solimp="0.98 0.999 0.001"/>
      <geom name="bl_SuctionTip_Ti_b_g" type="mesh" mesh="bl_SuctionTip_Ti_b" material="bl_SurgSteel" density="7800" condim="4" priority="2" friction="1.2 0.05 0.01" solref="0.005 1" solimp="0.98 0.999 0.001"/>
      <geom name="bl_Suture_Packet_g" type="mesh" mesh="bl_Suture_Packet" material="bl_PackagingWhite" density="7800" condim="4" priority="2" friction="1.2 0.05 0.01" solref="0.005 1" solimp="0.98 0.999 0.001"/>
      <geom name="bl_Suture_Packet_2_g" type="mesh" mesh="bl_Suture_Packet_2" material="bl_PackagingWhite" density="7800" condim="4" priority="2" friction="1.2 0.05 0.01" solref="0.005 1" solimp="0.98 0.999 0.001"/>
    </body>
    <!-- 스테이징: 스툴을 환자 반대편(로봇 마주보는 자리)로 이동. 좌면중심 (-0.56, 0.48),
         좌면상단 z=0.588 -> 0.530 = 앉은 의사의 엉덩이 절단면(z=0.516)이 좌면에 묻히는 높이 -->
    <body name="bl_stool" pos="0.29 0.13 -0.058">
      <geom name="bl_Stool_Base_g" type="mesh" mesh="bl_Stool_Base" material="bl_DarkPlastic"/>
      <geom name="bl_Stool_Pole_g" type="mesh" mesh="bl_Stool_Pole" material="bl_Chrome"/>
      <geom name="bl_Stool_Seat_g" type="mesh" mesh="bl_Stool_Seat" material="bl_CushionBlue"/>
    </body>
    <!-- 기구 19종 — 전부 freejoint (자유 이동 물체). 이름/사이트 4개는 episode.py 호환용 유지 -->
    <body name="instr_curette_lucas85" pos="0 0 0">
      <joint type="free" armature="2e-5" damping="0.02"/>
      <geom name="bl_Curette_Lucas85_g" type="mesh" mesh="bl_Curette_Lucas85" material="bl_SurgSteel" density="7800" condim="4" priority="2" friction="1.2 0.05 0.01" solref="0.005 1" solimp="0.98 0.999 0.001"/>
    </body>
