<mujoco model="dental_demo_v3_blender">
  <include file="openarm_bimanual_v3_teleop.xml"/>
  <include file="room_v3_teleop.xml"/>

  <!-- 물리 안정화: Euler 통합기는 기구처럼 관성이 1e-7 수준인 물체의 접촉에서 발산한다.
       implicitfast 는 감쇠/접촉을 암시적으로 처리해 같은 timestep 에서 훨씬 안정적. -->
  <option integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <headlight active="1" ambient="0.42 0.42 0.45" diffuse="0.55 0.55 0.58" specular="0.25 0.25 0.28"/>
    <quality shadowsize="8192" offsamples="8"/>
    <map shadowclip="2.5" shadowscale="0.7" znear="0.02"/>
    <rgba haze="0.16 0.18 0.22 1"/>
  </visual>

  <worldbody>
    <light name="key"  pos="0.3 -0.8 2.2" dir="0 0.3 -1" diffuse="0.8 0.8 0.8"/>
    <light name="fill" pos="-0.5 0.6 2.0" dir="0.2 -0.2 -1" diffuse="0.45 0.45 0.5"/>
    <light name="rim" pos="1.4 0.8 1.9" dir="-0.5 -0.3 -1" diffuse="0.35 0.34 0.32" specular="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="6 6 0.1" rgba="0.9 0.9 0.9 1"/>
    <geom name="wall_back" type="box" pos="0 3 1.8" size="6 0.05 2.2" rgba="0.83 0.87 0.88 1"/>
    <geom name="wall_side" type="box" pos="-3 0 1.8" size="0.05 6 2.2" rgba="0.83 0.87 0.88 1"/>
    <camera name="wide" pos="2.05 -2.15 2.05" fovy="46" mode="targetbody" target="cam_target"/>
    <!-- 스테이징 구도용: 의사(-0.88,0.58) - 환자 - 로봇(0.79,0.50) 3자가 한 프레임에 -->
    <camera name="staging" pos="-0.95 -2.10 1.75" fovy="40" mode="targetbody" target="cam_target"/>
  </worldbody>
